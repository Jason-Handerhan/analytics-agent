// Real upstream tables from the Instacart ML repo this project reuses
// (github.com/Jason-Handerhan/Kaggle-Instacart-Reorder-Engine-Portfolio-Project).
// Reference them here with declare() — never copy their .sqlx files into this repo.

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "base_analytical_table",
  description: "Order-line grain: one row per order x product, with product/aisle/department names already joined in."
});

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "prelim_user_order_features",
  description: "One row per (user, order): cumulative basket size, reorder ratio, organic affinity, days between orders."
});

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "prelim_user_product_features",
  description: "One row per (user, order, product): cumulative purchases, cart position, reorder streak for that product."
});

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "prelim_user_aisle_features",
  description: "One row per (user, order, aisle): cumulative products bought in that aisle and its share of the user's total."
});

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "prelim_user_department_features",
  description: "One row per (user, order, department): cumulative products bought in that department and its share of the user's total."
});

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "prelim_user_order_dow_wide",
  description: "One row per (user, order, product): that product's cumulative purchase count broken out by day of week (0-6)."
});

declare({
  database: "instacart-ml-model", schema: "building_blocks", name: "prelim_user_order_tod_wide",
  description: "One row per (user, order, product): that product's cumulative purchase count broken out by time of day."
});

declare({
  database: "instacart-ml-model", schema: "ml_model_feature_table", name: "final_ml_features_table",
  description: "ML training grain: one row per (user, candidate product, anchor order), with the reorder label and every engineered feature."
});
