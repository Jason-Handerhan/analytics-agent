config {
  type: "table",
  schema: "agent_safe",
  name: "candidate_reorder_features",
  tags: ["agent_safe"],
  description: "One row per (user, candidate product, anchor order) -- every product a user has ever ordered, evaluated as a reorder candidate for the order immediately following the anchor, with the reorder outcome label and the engineered features used to predict it. Use for questions correlating features against reorder likelihood; product_order_analysis is the right table for general order/product questions.",
  columns: {
    user_id: "Unique identifier for the customer this training example belongs to.",
    anchor_order_id: "Order used as the reference point for this row's cumulative features — the order immediately before the label order.",
    anchor_order_number: "Sequential order number of the anchor order within this user's order history.",
    candidate_product_id: "Product being evaluated as a reorder candidate — any product this user has ordered at least once before the anchor order.",
    department_id: "Unique identifier for the candidate product's department.",
    aisle_id: "Unique identifier for the candidate product's aisle.",
    product_name: "Human-readable name of the candidate product.",
    aisle: "Human-readable aisle name for the candidate product.",
    department: "Human-readable department name for the candidate product.",
    anchor_days_since_first_order: "Cumulative days since this user's first order, as of the anchor order.",
    label_order_id: "The order immediately following the anchor order — whether the candidate product appears in this order is what label_reordered records.",
    label_order_number: "Sequential order number of the label order (always anchor_order_number + 1).",
    label_reordered: "1 if the candidate product appears in the label order, 0 if not — the reorder outcome for this row.",
    label_order_dow: "Day of week the label order was placed (0 = Sunday through 6 = Saturday).",
    label_order_hour_of_day: "Hour of day the label order was placed, 24-hour format.",
    label_days_since_prior_order: "Days elapsed between the anchor order and the label order.",
    label_time_of_day: "Label order hour bucketed into morning, afternoon, evening, or nighttime.",
    label_days_since_first_order: "Cumulative days since this user's first order, as of the label order.",
    user_avg_days_between_orders: "This user's average days between orders, as of the anchor order.",
    user_distinct_product_count: "Count of distinct products this user has ever ordered, as of the anchor order.",
    user_organic_affinity_ratio: "Share of this user's cumulative product line items that are organic, as of the anchor order.",
    user_avg_basket_size: "This user's average number of products per order, as of the anchor order.",
    user_reorder_ratio: "Share of this user's cumulative product line items that were reorders, as of the anchor order.",
    label_dow_user_product_same_dow_count: "Cumulative times this user has purchased the candidate product on the same day of week as the label order.",
    label_tod_user_product_same_tod_count: "Cumulative times this user has purchased the candidate product during the same time-of-day bucket as the label order.",
    user_aisle_share: "Share of this user's cumulative product line items that come from the candidate product's aisle, as of the anchor order.",
    user_deptartment_share: "Share of this user's cumulative product line items that come from the candidate product's department, as of the anchor order. Column name is misspelled in the source ML table — preserved as-is rather than renamed.",
    user_product_cumulative_purchases: "Number of times this user has purchased the candidate product, as of the anchor order.",
    user_product_avg_cart_position: "This user's average add-to-cart position for the candidate product, as of the anchor order.",
    user_product_avg_relative_cart_position: "Same as user_product_avg_cart_position, but as a fraction of each order's basket size.",
    user_product_cart_position_last_order: "Add-to-cart position of the candidate product in the anchor order specifically, if it was purchased then; null otherwise.",
    user_product_purchase_concentration: "Share of this user's cumulative product line items that are the candidate product.",
    user_product_reorder_concentration: "Share of this user's cumulative reordered line items that are the candidate product.",
    user_product_order_penetration_ratio: "Share of this user's orders, up to the anchor order, that contained the candidate product.",
    user_product_consecutive_order_skips: "Number of orders since this user last purchased the candidate product, as of the anchor order.",
    user_product_last3order_streak: "How many of this user's last 3 consecutive orders, as of the anchor order, included the candidate product (0-3).",
    label_user_product_days_since_last_purchased: "Days between the user's last purchase of the candidate product, as of the anchor order, and the label order.",
    user_prod_avg_days_between_purchases: "This user's average days between purchases of the candidate product, as of the anchor order.",
    user_product_nearing_reorder_ratio: "How close this user is to their typical repurchase interval for the candidate product — days since last purchase divided by their average days between purchases of it. Values near or above 1 suggest a reorder is due.",
    days_since_last_ordered_vs_user_pace_ratio: "Days since the candidate product was last purchased, relative to this user's typical days between any order.",
    user_product_day_of_week_affinity: "Share of this user's purchases of the candidate product that happened on the label order's day of week.",
    user_product_time_of_day_affinity: "Share of this user's purchases of the candidate product that happened during the label order's time-of-day bucket."
  },
  // Replicated from final_ml_features_table's own assertions in the source ML
  // repo -- every referenced column is unchanged here, so the same checks
  // apply verbatim. The three product_name/aisle/department null checks are
  // new: they verify our added join actually matched, which final_ml_features_table
  // itself has no equivalent for.
  assertions: {
    // nonNull + uniqueKey: this project's documented assertion convention
    // (docs/data-pipeline.md's vector_db pipeline) -- a per-row check alone
    // can't catch a row whose identity itself is broken, or a build that
    // silently produced duplicate rows for the same training example.
    nonNull: ["user_id", "candidate_product_id", "anchor_order_id", "label_order_id", "label_reordered"],
    uniqueKey: ["user_id", "candidate_product_id", "anchor_order_id"],
    rowConditions: [
      // 1. Complete null check for all modeling features (excluding last cart position)
      "user_id IS NOT NULL",
      "anchor_order_id IS NOT NULL",
      "anchor_order_number IS NOT NULL",
      "candidate_product_id IS NOT NULL",
      "department_id IS NOT NULL",
      "aisle_id IS NOT NULL",
      "anchor_days_since_first_order IS NOT NULL",
      "label_order_id IS NOT NULL",
      "label_order_number IS NOT NULL",
      "label_reordered IS NOT NULL",
      "label_order_dow IS NOT NULL",
      "label_order_hour_of_day IS NOT NULL",
      "label_days_since_prior_order IS NOT NULL",
      "label_time_of_day IS NOT NULL",
      "label_days_since_first_order IS NOT NULL",
      "user_avg_days_between_orders IS NOT NULL",
      "user_distinct_product_count IS NOT NULL",
      "user_organic_affinity_ratio IS NOT NULL",
      "user_avg_basket_size IS NOT NULL",
      "user_reorder_ratio IS NOT NULL",
      "label_dow_user_product_same_dow_count IS NOT NULL",
      "label_tod_user_product_same_tod_count IS NOT NULL",
      "user_aisle_share IS NOT NULL",
      "user_deptartment_share IS NOT NULL",
      "user_product_cumulative_purchases IS NOT NULL",
      "user_product_avg_cart_position IS NOT NULL",
      "user_product_avg_relative_cart_position IS NOT NULL",
      "user_product_purchase_concentration IS NOT NULL",
      "user_product_reorder_concentration IS NOT NULL",
      "user_product_order_penetration_ratio IS NOT NULL",
      "user_product_consecutive_order_skips IS NOT NULL",
      "user_product_last3order_streak IS NOT NULL",
      "label_user_product_days_since_last_purchased IS NOT NULL",
      "user_prod_avg_days_between_purchases IS NOT NULL",
      "user_product_nearing_reorder_ratio IS NOT NULL",
      "days_since_last_ordered_vs_user_pace_ratio IS NOT NULL",
      "user_product_day_of_week_affinity IS NOT NULL",
      "user_product_time_of_day_affinity IS NOT NULL",

      // 2. Check for anchor and label order sequence logic
      "anchor_order_number = (label_order_number - 1)",

      // 3. Confirm cold-start filter is enforced
      "anchor_order_number > 4",

      // 4. Validate target label and streak bounds
      "label_reordered IN (0, 1)",
      "user_product_last3order_streak BETWEEN 0 AND 3",

      // 5. Validate calendar and time bounds
      "label_order_dow BETWEEN 0 AND 6",
      "label_order_hour_of_day BETWEEN 0 AND 23",

      // 6. Validate affinity percentages/ratios fall between 0 and 1
      "user_organic_affinity_ratio BETWEEN 0 AND 1",
      "user_reorder_ratio BETWEEN 0 AND 1",
      "user_product_day_of_week_affinity BETWEEN 0 AND 1",
      "user_product_time_of_day_affinity BETWEEN 0 AND 1",

      // 7. New vs the source ML table: verify the added name join matched
      "product_name IS NOT NULL",
      "aisle IS NOT NULL",
      "department IS NOT NULL"
    ]
  }
}

-- Grain: one row per (user, candidate product, anchor order) — kept at its
-- native ML-training grain, unlike product_order_analysis. This is the
-- table for questions correlating features against the reorder label;
-- collapsing to one row per (user, product) would destroy that history.
-- Only addition vs the source ML table: product_name/aisle/department,
-- looked up from base_analytical_table (a stable 1:1 mapping, deduped
-- before the join so it can't fan out this table's rows).
SELECT
  f.*,
  p.product_name,
  p.aisle,
  p.department
FROM ${ref("final_ml_features_table")} f
LEFT JOIN (
  SELECT DISTINCT product_id, product_name, aisle, department
  FROM ${ref("base_analytical_table")}
) p
  ON f.candidate_product_id = p.product_id
