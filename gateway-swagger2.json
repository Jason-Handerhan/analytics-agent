{
  "swagger": "2.0",
  "info": {
    "title": "Analytics Agent",
    "description": "Gateway for the conversational analytics agent",
    "version": "1.1"
  },
  "host": "analytics-gateway-551802026956.us-central1.run.app",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/conversation": {
      "post": {
        "summary": "Start a new conversation",
        "operationId": "PostConversation",
        "parameters": [
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/ConversationResponse" }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "summary": "Ask a question, or respond to a pending approval",
        "operationId": "PostAsk",
        "parameters": [
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/AskRequest" } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/AgentResponse" }
          }
        }
      }
    },
    "/ask/status/{conversation_id}": {
      "get": {
        "summary": "Poll live status for a turn in flight",
        "operationId": "GetAskStatus",
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "type": "string" },
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/StatusResponse" }
          }
        }
      }
    },
    "/ask/cancel/{conversation_id}": {
      "post": {
        "summary": "Request cancellation of a turn in flight",
        "operationId": "PostAskCancel",
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "type": "string" },
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/CancelResponse" }
          }
        }
      }
    },
    "/conversations": {
      "get": {
        "summary": "List past conversations for the calling user",
        "operationId": "GetConversations",
        "parameters": [
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/ConversationListResponse" }
          }
        }
      }
    },
    "/conversations/{conversation_id}/history": {
      "get": {
        "summary": "Every turn for one conversation, oldest first",
        "operationId": "GetConversationHistory",
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "type": "string" },
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/ConversationHistoryResponse" }
          }
        }
      }
    },
    "/conversations/{conversation_id}": {
      "delete": {
        "summary": "Soft-delete a conversation",
        "operationId": "DeleteConversation",
        "parameters": [
          { "name": "conversation_id", "in": "path", "required": true, "type": "string" },
          { "name": "x-api-key", "in": "header", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": { "$ref": "#/definitions/DeleteConversationResponse" }
          }
        }
      }
    }
  },
  "definitions": {
    "AskRequest": {
      "type": "object",
      "required": ["conversation_id"],
      "properties": {
        "question": { "type": "string" },
        "image_base64": { "type": "string" },
        "filter_context": { "type": "array", "items": { "type": "object" } },
        "active_page": { "type": "string" },
        "conversation_id": { "type": "string" },
        "approval_decision": { "type": "string", "enum": ["approved", "rejected"] },
        "model": { "type": "string" }
      }
    },
    "ConversationResponse": {
      "type": "object",
      "required": ["conversation_id"],
      "properties": {
        "conversation_id": { "type": "string" }
      }
    },
    "AgentResponse": {
      "type": "object",
      "required": ["answer_markdown", "answer_html", "sources"],
      "properties": {
        "answer_markdown": { "type": "string" },
        "answer_html": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "needs_approval": { "type": "boolean" },
        "chart_urls": { "type": "array", "items": { "type": "string" } },
        "suggested_follow_ups": { "type": "array", "items": { "type": "string" } },
        "iteration_cap_hit": { "type": "boolean" },
        "pending_query": { "type": "string" },
        "estimated_cost": { "type": "string" },
        "cost_cap_exceeded": { "type": "boolean" }
      }
    },
    "StatusResponse": {
      "type": "object",
      "required": ["status", "thinking_log"],
      "properties": {
        "status": { "type": "string" },
        "thinking_log": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "CancelResponse": {
      "type": "object",
      "required": ["cancel_requested"],
      "properties": {
        "cancel_requested": { "type": "boolean" }
      }
    },
    "ConversationSummary": {
      "type": "object",
      "required": ["conversation_id", "title", "last_activity_at"],
      "properties": {
        "conversation_id": { "type": "string" },
        "title": { "type": "string" },
        "last_activity_at": { "type": "string", "format": "date-time" }
      }
    },
    "ConversationListResponse": {
      "type": "object",
      "required": ["conversations"],
      "properties": {
        "conversations": { "type": "array", "items": { "$ref": "#/definitions/ConversationSummary" } }
      }
    },
    "ConversationTurn": {
      "type": "object",
      "required": ["question", "answer_html", "sources", "suggested_follow_ups", "needs_approval"],
      "properties": {
        "question": { "type": "string" },
        "answer_html": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "suggested_follow_ups": { "type": "array", "items": { "type": "string" } },
        "needs_approval": { "type": "boolean" }
      }
    },
    "ConversationHistoryResponse": {
      "type": "object",
      "required": ["turns"],
      "properties": {
        "turns": { "type": "array", "items": { "$ref": "#/definitions/ConversationTurn" } }
      }
    },
    "DeleteConversationResponse": {
      "type": "object",
      "required": ["deleted"],
      "properties": {
        "deleted": { "type": "boolean" }
      }
    }
  }
}
